NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# BlinkLabs MEV-protected RPC (https://portal.blinklabs.xyz).
# Ships in the client bundle -- origin-scope it in the portal, it is not a secret.
# Without it, writes fall back to the public RPCs with no MEV protection.
NEXT_PUBLIC_BLINK_API_KEY=your_blink_key_here
